{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/selftest.ts",
    "sw.js",
    "site/site.js",
    "tests/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "site/**/*.js"
  ],
  // used, but not from anything knip reads in this folder
  "ignoreDependencies": [
    // the desktop build's command (`npx --prefix app tauri build`)
    "@tauri-apps/cli",
    // the copy check, run from the repository's root (scripts/lint.sh)
    "jscpd",
    // Prettier's Svelte plugin, named by path in the repository's .prettierrc.json
    "prettier-plugin-svelte"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "enumMembers": "off"
  }
}
