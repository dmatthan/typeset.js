{
  "name": "volumen-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test --project=chromium --project=build --project=service --project=kit",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.19.2",
    "jscpd": "^4.3.0",
    "knip": "^5.88.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}
