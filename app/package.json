{
  "name": "typeset-app",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "playwright test --project=chromium --project=build --project=service --project=package",
    "test:slow": "CPU=4 playwright test --project=chromium --project=build --project=package",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:engines": "playwright test --project=firefox --project=webkit",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path ../.prettierignore ..",
    "format:check": "prettier --check --log-level warn --ignore-path ../.gitignore --ignore-path ../.prettierignore .."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "jscpd": "^5.4.3",
    "knip": "^6.49.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  }
}
